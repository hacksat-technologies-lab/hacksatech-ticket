# Paystack (use sk_test_... while testing, sk_live_... for real sales)
PAYSTACK_SECRET_KEY=
# Resend (same account and verified address as academy.hacksatech.com; only the display name differs)
RESEND_API_KEY=
EMAIL_FROM="Hacksat Connect <noreply@academy.hacksatech.com>"
# Google Sheet bridge (Apps Script web app, see apps-script/Code.gs)
SHEET_SCRIPT_URL=
SHEET_SCRIPT_SECRET=
# Random long string used to derive ticket IDs
TICKET_SECRET=
# Passcode for the hidden /desk page (cash ticket sales). At least 8 characters. Leave empty to switch the desk off.
DESK_PASSCODE=
# Public site URL (no trailing slash). Falls back to the Vercel URL.
SITE_URL=http://localhost:3000
